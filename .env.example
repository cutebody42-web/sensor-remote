# Windows client configuration. The shipped package already contains
# sensor-network.json; these variables override it when explicitly set.
SENSOR_MODE=RENDER_TEST
SENSOR_SERVER=https://sensor-rendezvous-production.up.railway.app
# SENSOR_WS is accepted as a fallback when SENSOR_SERVER is not set.
SENSOR_WS=wss://sensor-rendezvous-production.up.railway.app/ws

# Internet rendezvous service configuration. These are also accepted by the
# Railway/Render deployment templates.
RELAY_MAX_BITRATE=20000000
RELAY_MAX_FPS=60
RELAY_MAX_RESOLUTION=1920x1080
