# Windows client configuration. SENSOR_SERVER is the only required client value.
SENSOR_MODE=RENDER_TEST
SENSOR_SERVER=https://sensor-rendezvous.onrender.com
# SENSOR_WS is accepted as a fallback when SENSOR_SERVER is not set.
SENSOR_WS=wss://sensor-rendezvous.onrender.com/ws

# Render service configuration. These are also set by render.yaml.
RELAY_MAX_BITRATE=2000000
RELAY_MAX_FPS=15
RELAY_MAX_RESOLUTION=1280x720
